# ----------------------------------------------------------------------
# 1. Correct MIME Types (Prevents strict MIME-check failures on live)
# ----------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType text/css .css
  AddType application/javascript .js
  AddType image/x-icon .ico
  AddType image/png .png
  AddType image/svg+xml .svg
  AddType application/manifest+json .webmanifest
  AddType font/woff2 .woff2
</IfModule>

# ----------------------------------------------------------------------
# 2. Directory Trailing Slash (Prevents relative asset 404s on live)
# ----------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  
  # If requested path is a directory without trailing slash, redirect with trailing slash
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_URI} !(.*)/$
  RewriteRule ^(.*)$ $1/ [L,R=301]
</IfModule>

# ----------------------------------------------------------------------
# 3. Default Index Documents
# ----------------------------------------------------------------------
DirectoryIndex index.html index.php

# ----------------------------------------------------------------------
# 4. Cache-Control (Fresh updates with cache-busting ?v= query params)
# ----------------------------------------------------------------------
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "max-age=604800, public, must-revalidate"
  </FilesMatch>
</IfModule>
